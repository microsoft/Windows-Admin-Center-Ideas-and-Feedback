{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TriageOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "category",
    "mode",
    "severity",
    "labels",
    "summary",
    "missing_info",
    "ado_title",
    "ado_description_html",
    "ado_tags"
  ],
  "properties": {
    "category": { "type": "string", "enum": ["bug", "feature"] },
    "mode":     { "type": "string", "enum": ["aMode", "vMode", "both", "unknown"] },
    "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "labels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1, "maxLength": 60 }
    },
    "summary": { "type": "string", "minLength": 10, "maxLength": 800 },
    "missing_info": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "minLength": 3, "maxLength": 240 }
    },
    "ado_title": { "type": "string", "minLength": 5, "maxLength": 255 },
    "ado_description_html": { "type": "string", "minLength": 20, "maxLength": 32000 },
    "ado_tags": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "minLength": 2, "maxLength": 40 }
    }
  }
}
