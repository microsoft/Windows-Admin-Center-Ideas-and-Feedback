{
  "type": "message",
  "attachments": [
    {
      "contentType": "application/vnd.microsoft.card.adaptive",
      "contentUrl": null,
      "content": {
        "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
        "type": "AdaptiveCard",
        "version": "1.4",
        "body": [
          {
            "type": "TextBlock",
            "text": "New WAC feedback triaged",
            "weight": "Bolder",
            "size": "Medium",
            "wrap": true
          },
          {
            "type": "TextBlock",
            "text": "#{{ issue.number }} — {{ issue.title | tojson }}",
            "wrap": true
          },
          {
            "type": "FactSet",
            "facts": [
              { "title": "Category", "value": "{{ triage.category }}" },
              { "title": "Mode",     "value": "{{ triage.mode }}" },
              { "title": "Severity", "value": "{{ triage.severity }}" },
              { "title": "Author",   "value": "@{{ issue.user.login }}" },
              { "title": "ADO",      "value": "#{{ ado_id }}" }
            ]
          },
          {
            "type": "TextBlock",
            "text": {{ triage.summary | tojson }},
            "wrap": true,
            "isSubtle": false
          }{% if triage.missing_info %},
          {
            "type": "TextBlock",
            "text": "Asked customer for:",
            "weight": "Bolder",
            "wrap": true,
            "spacing": "Medium"
          },
          {
            "type": "TextBlock",
            "text": {{ ("- " ~ triage.missing_info | join("\n- ")) | tojson }},
            "wrap": true
          }{% endif %}
        ],
        "actions": [
          { "type": "Action.OpenUrl", "title": "View on GitHub", "url": "{{ issue.html_url }}" },
          { "type": "Action.OpenUrl", "title": "Open ADO work item", "url": "{{ ado_url }}" }
        ]
      }
    }
  ]
}
