<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    body { font-family: 'Segoe UI', Arial, sans-serif; color: #24292f; line-height: 1.45; }
    .wrap { max-width: 760px; margin: 0 auto; }
    .pill { display: inline-block; padding: 2px 8px; border-radius: 12px; font-size: 12px;
            background: #ddf4ff; color: #0969da; margin-right: 4px; }
    .pill.bug      { background: #ffebe9; color: #cf222e; }
    .pill.feature  { background: #dafbe1; color: #1a7f37; }
    .pill.high     { background: #ffebe9; color: #cf222e; }
    .pill.medium   { background: #fff8c5; color: #9a6700; }
    .pill.low      { background: #d2dff7; color: #0550ae; }
    .card { border: 1px solid #d0d7de; border-radius: 6px; padding: 14px 18px; margin: 12px 0;
            background: #f6f8fa; }
    .reply { background: #ffffff; border: 1px solid #d0d7de; border-radius: 6px;
             padding: 14px 18px; }
    .reply pre { background: transparent; white-space: pre-wrap; word-wrap: break-word; }
    h1 { font-size: 18px; margin-bottom: 4px; }
    h2 { font-size: 14px; margin-top: 18px; margin-bottom: 6px; color: #57606a;
         text-transform: uppercase; letter-spacing: 0.5px; }
    code { background: #eaeef2; padding: 1px 4px; border-radius: 3px; }
    .meta { color: #57606a; font-size: 13px; }
    .footer { color: #57606a; font-size: 11px; margin-top: 24px; border-top: 1px solid #d0d7de;
              padding-top: 8px; }
    a { color: #0969da; text-decoration: none; }
    ul { padding-left: 20px; }
  </style>
</head>
<body>
<div class="wrap">

  <h1>
    <a href="{{ issue.html_url }}">#{{ issue.number }} — {{ issue.title }}</a>
  </h1>
  <div class="meta">
    Filed by <strong>@{{ issue.user.login }}</strong>
    on {{ issue.created_at }} &middot; <a href="{{ issue.html_url }}">open in GitHub</a>
  </div>

  <div class="card">
    <span class="pill {{ triage.category }}">{{ triage.category|upper }}</span>
    <span class="pill {{ triage.severity }}">severity: {{ triage.severity }}</span>
    <span class="pill">{{ triage.mode }}</span>
    {% for l in triage.labels if l not in ['triaged'] %}
      <span class="pill">{{ l }}</span>
    {% endfor %}
    <p style="margin-top:10px"><strong>Summary:</strong> {{ triage.summary }}</p>
    <p style="margin:0"><strong>Would file ADO as:</strong> <code>{{ triage.ado_title }}</code></p>
  </div>

  <h2>Drafted customer reply</h2>
  <div class="reply">
    <pre>{{ reply_markdown }}</pre>
  </div>

  <h2>Original issue body (truncated)</h2>
  <div class="card">
    <pre>{{ issue_body_excerpt }}</pre>
  </div>

  <h2>Run details</h2>
  <ul>
    <li>Mode: <code>{{ run.mode }}</code>
        {% if run.use_mock_llm %}(mock LLM){% else %}(Azure OpenAI){% endif %}</li>
    <li>Dry-run: <code>{{ run.dry_run }}</code> — no comments, ADO items, or notifications were posted</li>
    <li>Runner: <code>{{ run.runner_host }}</code></li>
    <li>Started: {{ run.started_at }}</li>
    <li>Elapsed: {{ run.elapsed_seconds }}s</li>
    {% if run.ado %}<li>ADO (would be): #{{ run.ado.id }} — {{ run.ado.type }}</li>{% endif %}
  </ul>

  <div class="footer">
    Generated by the WAC Feedback Triage local demo runner.
    This is a <em>dry-run</em>: nothing was posted to the customer or to ADO.
    To execute against the live pipeline, see <code>.github/copilot-triage/RUNBOOK.md</code>.
  </div>
</div>
</body>
</html>
